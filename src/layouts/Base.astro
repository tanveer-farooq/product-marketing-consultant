---
import '@fontsource-variable/nunito';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  fullTitle?: boolean;
  noindex?: boolean;
}

const { title, description, type = 'website', image, fullTitle = false, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050507" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Writing`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo {title} {description} {type} {image} {fullTitle} {noindex} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-fg antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-md focus:bg-pink focus:px-3 focus:py-2 focus:font-bold focus:text-white">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {
      site.cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cloudflareAnalyticsToken })}
        />
      )
    }
  </body>
</html>
