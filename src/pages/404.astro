---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { href } from '../lib/url';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <section class="bg-orb py-24">
    <div class="container-site max-w-2xl">
      <p class="text-gradient text-7xl font-black">404</p>
      <h1 class="mt-4 text-4xl md:text-5xl">That page does not exist.</h1>
      <p class="mt-5 text-lg text-muted">The link may be old, or the page moved. The homepage has everything.</p>
      <div class="mt-8">
        <Button href={href('/')} size="lg">Back to the homepage</Button>
      </div>
    </div>
  </section>
</Base>
