---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found" description="That page does not exist." noindex>
  <section class="py-24">
    <div class="container-site max-w-2xl">
      <p class="text-sm text-muted">404</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-5xl">That page does not exist.</h1>
      <p class="mt-4 text-lg text-muted">The link may be old, or the page moved. The homepage has everything.</p>
      <div class="mt-8">
        <Button href="/">Back to the homepage</Button>
      </div>
    </div>
  </section>
</Base>
