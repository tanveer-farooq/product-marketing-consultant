---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { faq } from '../data/engagement';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.name}: product marketing for technical products`,
  url: new URL('/services/', Astro.site).href,
  description: site.description,
  provider: { '@type': 'Person', name: site.name },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.tagline },
    })),
  },
};
---

<Base
  title="Services and pricing"
  description="Fixed-scope product marketing engagements for AI, developer, QA and security companies: positioning sprint, launches, competitive intel, SEO / AI-search content, and fractional PMM."
>
  <JsonLd slot="head" data={ld} />

  <section class="py-16 md:py-24">
    <div class="container-site">
      <div class="max-w-3xl">
        <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">Services</h1>
        <p class="mt-4 text-lg text-muted">
          Every engagement is fixed scope, fixed price and fixed dates. You get editable source files and a walkthrough,
          and you own everything. Prices are starting points. A proposal follows the intro call.
        </p>
      </div>

      <div class="mt-12">
        {
          services.map((s) => (
            <article id={s.id} class="grid scroll-mt-24 gap-6 border-t border-line py-12 md:grid-cols-[2fr_3fr] md:gap-12">
              <div>
                {s.entry && (
                  <p class="mb-3 inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-medium text-accent">
                    Start here
                  </p>
                )}
                <h2 class="text-2xl font-semibold tracking-tight">{s.name}</h2>
                <p class="mt-2 text-muted">{s.tagline}</p>
                <dl class="mt-6 grid grid-cols-2 gap-4 text-sm md:grid-cols-1">
                  <div>
                    <dt class="text-muted">Timeline</dt>
                    <dd class="font-medium">{s.timeline}</dd>
                  </div>
                  <div>
                    <dt class="text-muted">Price</dt>
                    <dd class="font-medium">{s.price}</dd>
                  </div>
                </dl>
              </div>
              <div>
                <p>
                  <span class="font-medium">For:</span> {s.forWho}
                </p>
                <ul class="mt-4 space-y-2">
                  {s.includes.map((item) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line bg-surface/50 py-16 md:py-24">
    <div class="container-site">
      <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">Questions I get asked</h2>
      <dl class="mt-10 grid gap-8 md:grid-cols-2">
        {
          faq.map((item) => (
            <div>
              <dt class="text-lg font-semibold">{item.q}</dt>
              <dd class="mt-2 text-muted">{item.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Cta
    title="Not sure which one you need?"
    body="Book a call and describe the problem. I will tell you which offer fits, or that none of them do."
  />
</Base>
