---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { faq } from '../data/engagement';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: `${site.name}: product marketing for technical products`,
  url: new URL('/services/', Astro.site).href,
  description: site.description,
  provider: { '@type': 'Person', name: site.name },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name, description: s.tagline },
    })),
  },
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="Services and pricing"
  description="Fixed-scope product marketing engagements for AI, developer, QA and security companies: positioning sprint, launches, competitive intel, SEO / AI-search content, and fractional PMM."
>
  <JsonLd slot="head" data={ld} />
  <JsonLd slot="head" data={faqLd} />

  <section class="bg-orb py-16 md:py-24">
    <div class="container-site">
      <div class="max-w-3xl">
        <h1 class="text-5xl md:text-6xl">Services and <span class="text-gradient">pricing</span></h1>
        <p class="mt-5 text-lg text-muted">
          Every engagement is fixed scope, fixed price and fixed dates. You get editable source files and a walkthrough,
          and you own everything. Prices are starting points. A proposal follows the intro call.
        </p>
      </div>

      <div class="mt-12 grid gap-6">
        {
          services.map((s) => (
            <article
              id={s.id}
              class={`card grid scroll-mt-24 gap-8 p-6 md:grid-cols-[2fr_3fr] md:p-10 ${s.entry ? 'card-pink' : ''}`}
            >
              <div>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="text-3xl" aria-hidden="true">{s.emoji}</span>
                  {s.entry && <span class="pill pill-pink">⚡ Start here</span>}
                </div>
                <h2 class="mt-4 text-2xl md:text-3xl">{s.name}</h2>
                <p class="mt-2 text-muted">{s.tagline}</p>
                <dl class="mt-6 grid grid-cols-2 gap-4 text-sm md:grid-cols-1">
                  <div>
                    <dt class="font-bold text-muted">Timeline</dt>
                    <dd class="font-extrabold">{s.timeline}</dd>
                  </div>
                  <div>
                    <dt class="font-bold text-muted">Price</dt>
                    <dd class="font-extrabold">{s.price}</dd>
                  </div>
                </dl>
              </div>
              <div>
                <p class="font-bold">
                  <span class="text-pink">For:</span> {s.forWho}
                </p>
                <ul class="mt-4 space-y-2">
                  {s.includes.map((item) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true">✅</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="container-site">
      <div class="card card-pink mx-auto max-w-4xl p-6 md:p-10">
        <h2 class="text-3xl md:text-[2.5rem]">Frequently asked questions</h2>
        <div class="faq mt-6">
          {
            faq.map((item) => (
              <details open>
                <summary>{item.q}</summary>
                <div>{item.a}</div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Cta
    title="Not sure which one you need? 🤔"
    body="Book a call and describe the problem. I will tell you which offer fits, or that none of them do."
  />
</Base>
