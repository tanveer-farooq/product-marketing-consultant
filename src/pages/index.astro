---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WorkCard from '../components/WorkCard.astro';
import PostCard from '../components/PostCard.astro';
import Testimonials from '../components/Testimonials.astro';
import Marquee from '../components/Marquee.astro';
import OfferCard from '../components/OfferCard.astro';
import Cta from '../components/Cta.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, bookingHref, ctaLabel } from '../data/site';
import { coreServices } from '../data/services';
import { engagementSteps } from '../data/engagement';
import { getWork, getPosts } from '../lib/content';

const featured = (await getWork()).filter((w) => w.data.featured).slice(0, 3);
const posts = (await getPosts()).slice(0, 3);

const fits = [
  'Your website does not say what you do, or says it the same way three competitors do.',
  'A launch is coming next quarter and nobody owns it end to end.',
  'Sales keeps losing to the same two competitors and has nothing to counter with.',
  'You publish content, but Google and AI assistants send buyers elsewhere.',
];

const valueProps = [
  {
    emoji: '🧑‍💻',
    title: 'Written for engineers',
    body: 'Positioning comes from interviews with your engineers and customers, and is written so a developer nods instead of scrolling past.',
  },
  {
    emoji: '🚀',
    title: 'Ships on the date',
    body: 'Fixed scope, fixed price, fixed dates. Every launch asset on the day you promised the board.',
  },
  {
    emoji: '🔎',
    title: 'Found and cited',
    body: 'Content built to rank in Google and be cited by ChatGPT, Claude and Perplexity, without reading like it was written for a robot.',
  },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Product marketing consultant',
  description: site.description,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  ...(site.linkedin ? { sameAs: [site.linkedin] } : {}),
};
---

<Base
  title={`${site.name} | Product marketing consultant for AI, developer and security companies`}
  description={site.description}
  fullTitle
>
  <JsonLd slot="head" data={person} />

  <section class="bg-orb pt-14 pb-12 md:pt-24 md:pb-20">
    <div class="container-site grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="mb-4 text-sm font-extrabold tracking-wide text-pink uppercase">
          Product marketing for AI, developer, QA and security companies
        </p>
        <h1 class="text-5xl md:text-6xl">
          Product marketing for <span class="text-gradient">technical products</span>.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted md:text-xl">
          I help technical companies say what they do, launch what they build, and get found by the people who buy it.
          Positioning, launches, competitive intel and content, done by someone who has shipped all four inside a
          developer company.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <Button href={bookingHref} size="lg">{ctaLabel}</Button>
          <Button href="/work/" variant="outline" size="lg">See the work</Button>
        </div>
      </div>
      <OfferCard />
    </div>
  </section>

  <Marquee />

  {
    site.proof.length > 0 && (
      <section class="py-10">
        <div class="container-site grid gap-6 sm:grid-cols-3">
          {site.proof.map((p) => (
            <div class="card p-6">
              <p class="text-gradient text-4xl font-black">{p.value}</p>
              <p class="mt-2 text-sm font-bold text-muted">{p.label}</p>
            </div>
          ))}
          <p class="text-xs text-muted sm:col-span-3">Client names withheld under NDA. Details on a call.</p>
        </div>
      </section>
    )
  }

  <Section
    variant="violet"
    corners="tl-br"
    title={'Built for technical companies at the point where "the founder explains it" stops scaling.'}
    center
  >
    <div class="grid gap-6 md:grid-cols-3">
      {
        valueProps.map((v) => (
          <div class="value-box">
            <span class="text-4xl" aria-hidden="true">{v.emoji}</span>
            <h3 class="mt-4 text-2xl">{v.title}</h3>
            <p class="mt-2 text-muted">{v.body}</p>
          </div>
        ))
      }
    </div>
    <div class="mx-auto mt-8 grid max-w-4xl gap-6 text-left md:grid-cols-[3fr_2fr]">
      <div class="value-box items-start text-left">
        <p class="text-lg font-extrabold">Sounds like you if at least one of these is true 👇</p>
        <ul class="mt-4 space-y-2 text-[0.95rem] text-muted">
          {
            fits.map((f) => (
              <li class="flex gap-2">
                <span aria-hidden="true">✅</span>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="value-box items-start text-left">
        <p class="text-lg font-extrabold">Not a fit 🚫</p>
        <p class="mt-4 text-[0.95rem] text-muted">
          Consumer products, agencies, paid-ads or social management, or a company that needs a twelve-person team.
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="services"
    title="Four things I do 🛠️"
    intro="Each one ships as a finished asset, not a deck. Hover a card for timeline and price."
    center
  >
    <div class="grid gap-5 text-left md:grid-cols-2 lg:grid-cols-4">
      {coreServices.map((s) => <ServiceCard service={s} />)}
    </div>
    <p class="mt-10"><a href="/services/" class="btn btn-gradient btn-lg">All services and pricing</a></p>
  </Section>

  <Section title="How an engagement runs 🚀" center>
    <ol class="grid gap-5 text-left sm:grid-cols-2 lg:grid-cols-5">
      {
        engagementSteps.map((step, i) => (
          <li class="card p-5">
            <span class="pill">Step {i + 1}</span>
            <h3 class="mt-4 text-lg">{step.title}</h3>
            <p class="mt-2 text-[0.95rem] text-muted">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {
    featured.length > 0 && (
      <Section
        title="Selected work 🔒"
        intro="Real engagements, anonymised. Client names are withheld under NDA. The numbers are real but rounded."
        center
      >
        <div class="grid gap-6 text-left md:grid-cols-3">
          {featured.map((entry) => (
            <WorkCard entry={entry} />
          ))}
        </div>
        <p class="mt-10">
          <a href="/work/" class="btn btn-outline btn-lg">
            All case studies
          </a>
        </p>
      </Section>
    )
  }

  <Section>
    <div class="card card-pink mx-auto max-w-4xl p-8 md:p-12">
      <h2 class="text-3xl md:text-[2.5rem]">Why hire a product marketer who has done it in-house</h2>
      <p class="mt-5 text-lg text-muted">
        I spent [N] years inside a developer-facing test-automation company, owning positioning, launches, competitive
        research and SEO. I know what a launch looks like from inside the standup, and what developers do with marketing
        copy they do not trust. That is the work I now do for technical companies that cannot hire a full-time PMM yet.
      </p>
      <p class="mt-6">
        <a href="/about/" class="font-bold text-pink underline-offset-4 hover:underline">More about me →</a>
      </p>
    </div>
  </Section>

  <Testimonials />

  {
    posts.length > 0 && (
      <Section title="Writing ✍️" intro="Positioning teardowns and notes on marketing technical products." center>
        <div class="mx-auto grid max-w-3xl gap-4 text-left">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
        <p class="mt-10">
          <a href="/writing/" class="btn btn-outline">
            All writing
          </a>
        </p>
      </Section>
    )
  }

  <Cta />
</Base>
