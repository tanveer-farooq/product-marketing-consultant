---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { segments } from '../../data/segments';
import { getWork } from '../../lib/content';
import { href } from '../../lib/url';

export const getStaticPaths = (async () => {
  const entries = await getWork();
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const d = entry.data;
---

<Base title={d.title} description={d.summary} type="article">
  <article class="bg-orb py-16 md:py-24">
    <div class="container-site">
      <header class="max-w-3xl">
        <p class="text-sm font-bold text-muted">
          <a href={href('/work/')} class="transition-colors hover:text-pink">Work</a> / <span class="text-pink">{segments[d.segment]}</span>{d.draft && ' / Draft'}
        </p>
        <h1 class="mt-4 text-4xl md:text-5xl">{d.title}</h1>
        <p class="mt-5 text-lg text-muted">{d.summary}</p>
      </header>

      <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_3fr]">
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <dl class="card space-y-4 p-5 text-sm">
            <div>
              <dt class="font-bold text-muted">Client</dt>
              <dd class="font-extrabold">{d.client}</dd>
            </div>
            <div>
              <dt class="font-bold text-muted">Stage</dt>
              <dd class="font-extrabold">{d.stage}{d.size && `, ${d.size}`}</dd>
            </div>
            <div>
              <dt class="font-bold text-muted">Services</dt>
              <dd class="font-extrabold">{d.services.join(', ')}</dd>
            </div>
            {
              d.period && (
                <div>
                  <dt class="font-bold text-muted">When</dt>
                  <dd class="font-extrabold">{d.period}</dd>
                </div>
              )
            }
          </dl>
          {
            d.outcomes.length > 0 && (
              <dl class="mt-4 grid gap-3">
                {d.outcomes.map((o) => (
                  <div class="card flex flex-col-reverse p-4">
                    <dt class="text-sm font-bold text-muted">{o.label}</dt>
                    <dd class="text-gradient text-3xl font-black">{o.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          <p class="mt-4 text-xs text-muted">Client name withheld under NDA. Details on a call.</p>
        </aside>

        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <Cta />
</Base>
