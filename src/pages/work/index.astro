---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import Cta from '../../components/Cta.astro';
import { segments, type Segment } from '../../data/segments';
import { getWork } from '../../lib/content';

const work = await getWork();
const present = (Object.keys(segments) as Segment[]).filter((s) => work.some((w) => w.data.segment === s));
---

<Base
  title="Work"
  description="Anonymised case studies: positioning, launches, competitive intel and SEO / AI-search content for AI, developer, QA and security companies."
>
  <section class="bg-orb py-16 md:py-24">
    <div class="container-site">
      <p class="mb-3 text-sm font-extrabold tracking-wide text-pink uppercase">Case studies</p>
      <h1 class="text-5xl md:text-6xl">Selected <span class="text-gradient">work</span> 🔒</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Real engagements, anonymised. Client names are withheld under NDA. The numbers are real but rounded. Details on
        a call.
      </p>

      {
        present.length > 1 && (
          <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Filter by segment">
            <button type="button" data-filter="all" aria-pressed="true" class="filter-chip">
              All
            </button>
            {present.map((s) => (
              <button type="button" data-filter={s} aria-pressed="false" class="filter-chip">
                {segments[s]}
              </button>
            ))}
          </div>
        )
      }

      {
        work.length > 0 ? (
          <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {work.map((entry) => (
              <WorkCard entry={entry} />
            ))}
          </div>
        ) : (
          <p class="mt-10 text-muted">Case studies are being written. Ask me on a call in the meantime.</p>
        )
      }
    </div>
  </section>

  <Cta />
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-segment]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      cards.forEach((card) => {
        card.hidden = filter !== 'all' && card.dataset.segment !== filter;
      });
    });
  });
</script>
