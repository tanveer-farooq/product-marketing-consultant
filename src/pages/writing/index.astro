---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Cta from '../../components/Cta.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base
  title="Writing"
  description="Positioning teardowns and notes on marketing technical products: AI, developer tools, QA and security."
>
  <section class="py-16 md:py-24">
    <div class="container-site">
      <h1 class="text-3xl font-semibold tracking-tight md:text-5xl">Writing</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Positioning teardowns and notes on marketing technical products. <a href="/rss.xml" class="text-accent hover:underline">RSS</a>
      </p>

      <div class="mt-10 max-w-3xl">
        {
          posts.length > 0 ? (
            posts.map((post) => <PostCard post={post} />)
          ) : (
            <p class="text-muted">First pieces are on the way.</p>
          )
        }
      </div>
    </div>
  </section>

  <Cta />
</Base>
