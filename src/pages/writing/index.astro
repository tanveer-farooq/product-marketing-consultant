---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import Cta from '../../components/Cta.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base
  title="Writing"
  description="Positioning teardowns and notes on marketing technical products: AI, developer tools, QA and security."
>
  <section class="bg-orb py-16 md:py-24">
    <div class="container-site">
      <p class="mb-3 text-sm font-extrabold tracking-wide text-pink uppercase">Writing</p>
      <h1 class="text-5xl md:text-6xl">Teardowns and <span class="text-gradient">notes</span> ✍️</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted">
        Positioning teardowns and notes on marketing technical products.
        <a href="/rss.xml" class="font-bold text-pink underline-offset-4 hover:underline">RSS</a>
      </p>

      <div class="mt-10 grid max-w-3xl gap-4">
        {
          posts.length > 0 ? (
            posts.map((post) => <PostCard post={post} />)
          ) : (
            <p class="text-muted">First pieces are on the way.</p>
          )
        }
      </div>
    </div>
  </section>

  <Cta />
</Base>
