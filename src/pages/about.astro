---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Cta from '../components/Cta.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, bookingHref, ctaLabel } from '../data/site';
import { abs } from '../lib/url';

const lessons = [
  "Positioning comes from interviews, not brainstorms. The customer's alternative tells you what to say.",
  'Developers are the toughest audience and the easiest to write for. They want specifics. Give them specifics.',
  'A launch is a date and a list. Most launches fail on the list.',
];

const howIWork = [
  'Fixed scope, fixed price, fixed dates.',
  'Weekly check-ins and drafts you can see early.',
  'Everything in editable files you own.',
  'I say no to work I am not the right person for, and I will tell you who is.',
];

// TODO: replace with the tools you actually use.
const tools = ['Ahrefs', 'Google Search Console', 'Figma', 'Google Docs / Notion', 'Claude', 'Linear / Jira', 'HubSpot / Attio'];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Product marketing consultant',
  description: site.description,
  url: abs('/about/', Astro.site),
  email: `mailto:${site.email}`,
  ...(site.linkedin ? { sameAs: [site.linkedin] } : {}),
};
---

<Base
  title="About"
  description={`${site.name} is a freelance product marketer with in-house experience at a developer-facing test-automation company. Positioning, launches, competitive intel and SEO for technical companies.`}
>
  <JsonLd slot="head" data={person} />

  <section class="bg-orb py-16 md:py-24">
    <div class="container-site grid gap-12 lg:grid-cols-[2fr_1fr]">
      <div>
        <p class="mb-3 text-sm font-extrabold tracking-wide text-pink uppercase">About</p>
        <h1 class="text-5xl md:text-6xl">{site.name}</h1>
        <p class="mt-4 text-lg text-muted">
          Product marketer for technical products. Based in {site.location}. Working with teams in {site.regions}.
        </p>

        <div class="prose prose-lg mt-10 max-w-none">
          <p>
            I am a product marketer who spent 5 years inside a developer-facing test-automation company, including a
            company-wide rebrand and repositioning. I owned positioning for 4 products, ran launches, built the
            competitive program, and led SEO and AI-search visibility work, including brand-mention and backlink
            programs after the rebrand.
          </p>
          <p>That work taught me three things I now bring to clients:</p>
        </div>

        <ol class="mt-6 grid gap-4 md:grid-cols-3">
          {
            lessons.map((l, i) => (
              <li class="card p-5">
                <span class="pill">{i + 1}</span>
                <p class="mt-3 font-semibold">{l}</p>
              </li>
            ))
          }
        </ol>

        <h2 class="mt-12 text-3xl">How I work</h2>
        <ul class="mt-4 space-y-2">
          {
            howIWork.map((h) => (
              <li class="flex gap-3">
                <span aria-hidden="true">✅</span>
                <span>{h}</span>
              </li>
            ))
          }
        </ul>

        <h2 class="mt-12 text-3xl">Tools I actually use</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {tools.map((t) => <span class="pill-item">{t}</span>)}
        </div>
      </div>

      <aside class="lg:pt-10">
        <div class="card-hard p-2">
          {
            site.headshot ? (
              <img src={site.headshot} alt={site.name} width="480" height="480" class="aspect-square w-full rounded-md object-cover" />
            ) : (
              <div aria-hidden="true" class="flex aspect-square w-full items-center justify-center rounded-md bg-surface-2">
                <span class="text-gradient text-8xl font-black">{site.name.charAt(0)}</span>
              </div>
            )
          }
        </div>
        <div class="mt-8 flex flex-col gap-3">
          <Button href={bookingHref}>{ctaLabel}</Button>
          {
            site.linkedin && (
              <Button href={site.linkedin} variant="outline">
                LinkedIn
              </Button>
            )
          }
          <a href={`mailto:${site.email}`} class="text-center text-sm font-bold text-muted transition-colors hover:text-pink">{site.email}</a>
        </div>
      </aside>
    </div>
  </section>

  <Cta title="Working on something? 🚀" body="Book a call and describe the problem. I will tell you which offer fits, or that none of them do." />
</Base>
