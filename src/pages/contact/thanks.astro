---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { bookingHref, ctaLabel } from '../../data/site';
---

<Base title="Thanks" description="Message received." noindex>
  <section class="bg-orb py-24">
    <div class="container-site max-w-2xl">
      <h1 class="text-5xl md:text-6xl">Thanks 🙌</h1>
      <p class="mt-5 text-lg text-muted">I will reply within one business day. If it is urgent, book a slot directly.</p>
      <div class="mt-8">
        <Button href={bookingHref} size="lg">{ctaLabel}</Button>
      </div>
    </div>
  </section>
</Base>
