---
import { site } from '../data/site';
import { href } from '../lib/url';
import LinkedInIcon from './LinkedInIcon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line">
  <div class="container-site grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="text-xl font-black">{site.name}</p>
      <p class="mt-2 max-w-xs text-sm text-muted">{site.title}. {site.tagline}</p>
    </div>

    <nav aria-label="Footer" class="grid grid-cols-2 gap-2 text-sm font-bold">
      {
        site.nav.map((item) => (
          <a href={href(item.href)} class="text-muted transition-colors hover:text-pink">
            {item.label}
          </a>
        ))
      }
      <a href={href('/contact/')} class="text-muted transition-colors hover:text-pink">Contact</a>
      <a href={href('/rss.xml')} class="text-muted transition-colors hover:text-pink">RSS</a>
    </nav>

    <div class="text-sm text-muted">
      <p><a href={`mailto:${site.email}`} class="font-bold transition-colors hover:text-pink">{site.email}</a></p>
      {
        site.linkedin && (
          <p class="mt-1">
            <a href={site.linkedin} target="_blank" rel="me noopener" class="inline-flex items-center gap-2 font-bold transition-colors hover:text-pink">
              <LinkedInIcon class="size-4" /> LinkedIn
            </a>
          </p>
        )
      }
      <p class="mt-4">Client names in case studies are withheld under NDA.</p>
      <p class="mt-1">&copy; {year} {site.name}</p>
    </div>
  </div>
</footer>
