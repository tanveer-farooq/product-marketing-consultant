---
import Button from './Button.astro';
import { site, bookingHref, ctaLabel } from '../data/site';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Tell me what you are launching or repositioning.',
  body = 'One 30-minute call. If I am not the right fit, I will say so and point you somewhere better.',
} = Astro.props;
---

<section class="py-16 md:py-24">
  <div class="container-site">
    <div class="rounded-2xl bg-fg px-6 py-12 text-bg md:px-12 md:py-16">
      <h2 class="max-w-2xl text-3xl font-semibold tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-4 max-w-xl text-lg opacity-80">{body}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <Button href={bookingHref}>{ctaLabel}</Button>
        <a href={`mailto:${site.email}`} class="text-base font-medium underline-offset-4 hover:underline">
          or email {site.email}
        </a>
      </div>
    </div>
  </div>
</section>
