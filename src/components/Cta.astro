---
import Button from './Button.astro';
import { site, bookingHref, ctaLabel } from '../data/site';
import LinkedInIcon from './LinkedInIcon.astro';

interface Props {
  title?: string;
  body?: string;
}

const {
  title = 'Tell me what you are launching or repositioning ✉️',
  body = 'One 30-minute call. If I am not the right fit, I will say so and point you somewhere better.',
} = Astro.props;
---

<section class="section-violet corner-tr py-16 md:py-24">
  <div class="container-site flex flex-col items-center text-center">
    <h2 class="max-w-2xl text-3xl md:text-[2.5rem]">{title}</h2>
    <p class="mt-4 max-w-xl text-lg font-bold text-white/85">{body}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <Button href={bookingHref} size="lg">{ctaLabel}</Button>
      {
        site.booking && (
          <a href={`mailto:${site.email}`} class="font-bold underline-offset-4 hover:underline">
            or email {site.email}
          </a>
        )
      }
      {
        site.linkedin && (
          <a href={site.linkedin} target="_blank" rel="me noopener" class="btn btn-outline btn-lg">
            <LinkedInIcon /> Connect on LinkedIn
          </a>
        )
      }
    </div>
  </div>
</section>
