---
import { site } from '../data/site';
import { href } from '../lib/url';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  image?: string;
  fullTitle?: boolean;
  noindex?: boolean;
}

const { title, description, type = 'website', image = '/og.png', fullTitle = false, noindex = false } = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
// Directory-style build output means every page lives at a trailing-slash URL. Normalise the canonical to match.
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL.slice(0, -1) : import.meta.env.BASE_URL;
const rawPath = Astro.url.pathname;
const path = base && !rawPath.startsWith(base) ? `${base}${rawPath}` : rawPath;
const canonicalPath = path.endsWith('/') || /\.[a-z0-9]+$/i.test(path) ? path : `${path}/`;
const canonical = new URL(canonicalPath, Astro.site);
const ogImage = new URL(href(image), Astro.site);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={site.name} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
