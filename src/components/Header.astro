---
import { site, bookingHref, ctaLabel } from '../data/site';
import { href } from '../lib/url';
import LinkedInIcon from './LinkedInIcon.astro';

const current = Astro.url.pathname;
const isActive = (href: string) => current.startsWith(href.replace(/\/$/, ''));
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur">
  <div class="container-site flex h-[72px] items-center justify-between gap-6">
    <a href={href('/')} class="text-xl font-black tracking-tight text-fg transition-colors hover:text-pink">{site.name}</a>

    <nav aria-label="Main" class="hidden items-center gap-7 text-[0.95rem] font-bold md:flex">
      {
        site.nav.map((item) => (
          <a
            href={href(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="text-fg/80 transition-colors hover:text-pink aria-[current=page]:text-pink"
          >
            {item.label}
          </a>
        ))
      }
      {
        site.linkedin && (
          <a href={site.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn profile" class="text-fg/80 transition-colors hover:text-pink">
            <LinkedInIcon />
          </a>
        )
      }
      <a href={bookingHref} class="btn btn-gradient btn-sm">{ctaLabel}</a>
    </nav>

    <details class="relative md:hidden">
      <summary class="btn btn-outline btn-sm cursor-pointer list-none select-none">Menu</summary>
      <div class="absolute right-0 z-40 mt-2 flex w-60 flex-col gap-1 rounded-xl border border-line-strong bg-bg p-2 shadow-2xl">
        {
          site.nav.map((item) => (
            <a href={href(item.href)} class="rounded-lg px-3 py-2 font-bold transition-colors hover:bg-surface-2 hover:text-pink">
              {item.label}
            </a>
          ))
        }
        {
          site.linkedin && (
            <a href={site.linkedin} target="_blank" rel="me noopener" class="flex items-center gap-2 rounded-lg px-3 py-2 font-bold transition-colors hover:bg-surface-2 hover:text-pink">
              <LinkedInIcon /> LinkedIn
            </a>
          )
        }
        <a href={bookingHref} class="btn btn-gradient mt-1">{ctaLabel}</a>
      </div>
    </details>
  </div>
</header>
