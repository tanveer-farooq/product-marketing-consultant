---
interface Props {
  href: string;
  variant?: 'gradient' | 'violet' | 'outline' | 'primary' | 'secondary';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const { href, variant = 'gradient', size = 'md', class: className = '' } = Astro.props;
const variants = {
  gradient: 'btn-gradient',
  primary: 'btn-gradient',
  violet: 'btn-violet',
  outline: 'btn-outline',
  secondary: 'btn-outline',
};
const sizes = { sm: 'btn-sm', md: '', lg: 'btn-lg' };
---

<a href={href} class={`btn ${variants[variant]} ${sizes[size]} ${className}`}><slot /></a>
