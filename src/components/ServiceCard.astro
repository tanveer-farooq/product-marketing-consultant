---
import type { Service } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a
  href={`/services/#${service.id}`}
  class="group flex flex-col rounded-xl border border-line bg-surface p-6 transition-colors hover:border-accent"
>
  {service.pillar && <p class="text-sm font-medium text-accent">{service.pillar}</p>}
  <h3 class="mt-2 text-xl font-semibold tracking-tight">{service.name}</h3>
  <p class="mt-3 flex-1 text-muted">{service.short}</p>
  <span class="mt-5 text-sm font-medium text-fg group-hover:text-accent">Details and pricing</span>
</a>
