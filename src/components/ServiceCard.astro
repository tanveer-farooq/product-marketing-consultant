---
import type { Service } from '../data/services';
import { href } from '../lib/url';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<a href={href(`/services/#${service.id}`)} class="card card-hover card-flip relative flex flex-col p-6">
  <span class="text-3xl" aria-hidden="true">{service.emoji}</span>
  {service.pillar && <p class="mt-4 text-xs font-extrabold tracking-wide text-pink uppercase">{service.pillar}</p>}
  <h3 class="mt-1 text-xl">{service.name}</h3>
  <p class="mt-3 flex-1 text-[0.95rem] text-muted">{service.short}</p>
  <span class="mt-5 text-sm font-bold">Details and pricing →</span>
  <span class="stat-overlay" aria-hidden="true">
    <span>{service.timeline}<br />{service.price}</span>
  </span>
</a>
