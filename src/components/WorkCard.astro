---
import type { CollectionEntry } from 'astro:content';
import { segments } from '../data/segments';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, client, segment, summary, outcomes, draft } = entry.data;
---

<a href={`/work/${entry.id}/`} data-segment={segment} class="card card-hover flex flex-col p-6">
  <p class="text-xs font-extrabold tracking-wide text-pink uppercase">
    {segments[segment]}{draft && ' · Draft'}
  </p>
  <p class="mt-1 text-sm font-bold text-muted">{client}</p>
  <h3 class="mt-3 text-xl">{title}</h3>
  <p class="mt-3 flex-1 text-[0.95rem] text-muted">{summary}</p>
  {
    outcomes.length > 0 && (
      <dl class="mt-5 grid grid-cols-2 gap-3">
        {outcomes.slice(0, 2).map((o) => (
          <div class="flex flex-col-reverse">
            <dt class="text-xs font-bold tracking-wide text-muted uppercase">{o.label}</dt>
            <dd class="text-gradient text-2xl font-black">{o.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <span class="mt-5 text-sm font-bold">Read the case study →</span>
</a>
