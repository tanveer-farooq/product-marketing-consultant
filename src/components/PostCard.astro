---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  post: CollectionEntry<'writing'>;
}

const { post } = Astro.props;
---

<article class="border-t border-line py-6">
  <p class="text-sm text-muted">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>{post.data.draft && ' · DRAFT'}
  </p>
  <h3 class="mt-1 text-xl font-semibold tracking-tight">
    <a href={`/writing/${post.id}/`} class="hover:text-accent">{post.data.title}</a>
  </h3>
  <p class="mt-2 text-muted">{post.data.description}</p>
</article>
